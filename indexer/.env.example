# Neko Sui indexer — Phase 1: raw checkpoint intake + cursor
#
# Sui gRPC v2 endpoint (public-good; switch to provider/fullnode for prod)
SUI_ENDPOINT=https://fullnode.mainnet.sui.io:443
SUI_CHAIN_ID=35834a8a

# PostgreSQL (local peer auth via unix socket)
DATABASE_URL=postgres:///neko_indexer

# Stream behaviour
#   tip  -> start live at the chain tip
#   db   -> resume from persisted cursor (default)
#   <seq>-> start at explicit sequence number
CHECKPOINT_START=db

# Observability
RUST_LOG=info,neko_indexer=debug
METRICS_INTERVAL_SECS=10